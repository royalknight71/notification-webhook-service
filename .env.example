# Example environment configuration

# DATABASE_URL: PostgreSQL connection string.
# Example: postgres://user:password@localhost:5432/notification_service?sslmode=disable
DATABASE_URL=

# PORT: Port the server listens on (default :8080)
PORT=8081

# RabbitMQ connection URL (amqp://user:pass@host:5672/)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Optional RabbitMQ configuration (defaults shown)
RABBITMQ_EXCHANGE=webhook_exchange
RABBITMQ_QUEUE=webhook_queue
RABBITMQ_ROUTING_KEY=webhook_key

# Secret used for HMAC signing of outgoing webhook requests
WEBHOOK_SECRET=
